{
  "name": "minhlab-3d",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "deploy:package": "node scripts/deploy/package-release.cjs",
    "files:reconcile-purges": "node scripts/deploy/reconcile-purges.cjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint app src proxy.ts",
    "db:start": "bash scripts/database/db-start.sh",
    "db:stop": "bash scripts/database/db-stop.sh",
    "db:status": "bash scripts/database/db-status.sh",
    "db:seed": "node scripts/database/db-seed-catalog.cjs",
    "db:migrate": "node scripts/database/db-migrate.cjs",
    "mail:deliver": "node scripts/workers/mail-deliver.cjs",
    "telegram:deliver": "node scripts/workers/telegram-deliver.cjs",
    "telegram:poll": "node scripts/workers/telegram-poll.cjs",
    "telegram:webhook:set": "node scripts/telegram-webhook.cjs set",
    "telegram:webhook:delete": "node scripts/telegram-webhook.cjs delete",
    "telegram:webhook:info": "node scripts/telegram-webhook.cjs info",
    "test:production": "node scripts/tests/test-production.cjs",
    "check": "tsc --noEmit && eslint app src proxy.ts && npm run check:architecture",
    "test:quote": "node --require ./scripts/lib/register-typescript.cjs --test src/lib/quote/test/analyze.test.ts src/lib/quote/test/quote.test.ts src/lib/quote/test/reference-model.test.ts src/lib/quote/test/resource-model.test.ts",
    "benchmark:stl": "node --require ./scripts/lib/register-typescript.cjs scripts/quote/benchmark-stl-quote.cjs",
    "test:models": "node scripts/tests/test-scene-customization.cjs",
    "production:check": "node scripts/checks/check-production.cjs",
    "db:grant-runtime": "node scripts/database/db-grant-runtime.cjs",
    "db:runtime-role": "node scripts/database/db-runtime-role.cjs",
    "test:checkout": "node --require ./scripts/lib/register-typescript.cjs --test src/lib/test/checkout-request.test.ts src/lib/test/checkout-validation.test.ts",
    "check:architecture": "node scripts/checks/check-architecture.cjs",
    "architecture:report": "node scripts/checks/report-architecture.cjs",
    "test:architecture": "node --test scripts/tests/test-architecture.cjs",
    "test:orders": "node --require ./scripts/lib/register-typescript.cjs --test src/domain/orders/test/order-policy.test.ts src/repositories/orders/test/order-mapping.test.ts src/services/orders/test/order-checkout.test.ts src/services/orders/test/order-workflows.test.ts src/services/orders/test/payment-proof-validation.test.ts src/services/orders/test/order-return.service.test.ts",
    "test:unit": "npm run test:architecture && npm run test:auth && npm run test:orders && npm run test:checkout && npm run test:catalog && npm run test:hardening && npm run test:telegram && npm run test:quote && npm run test:models && npm run test:print-request && npm run test:production-domain",
    "test:telegram": "node --require ./scripts/lib/register-typescript.cjs --test scripts/tests/test-telegram-deliver.test.cjs src/lib/test/telegram-outbox.test.ts src/lib/test/telegram-webhook.test.ts src/services/auth/test/telegram-link.test.ts scripts/tests/test-notification-worker.test.cjs scripts/tests/test-telegram-payment-callback.test.cjs",
    "test:catalog": "node --require ./scripts/lib/register-typescript.cjs --test src/lib/test/catalog.test.ts src/lib/test/catalog-image-validation.test.ts src/lib/test/cloudinary-image-loader.test.ts src/integrations/media/test/cloudinary-images.test.ts src/repositories/catalog/test/catalog-image.repository.test.ts src/services/catalog/test/catalog-image.service.test.ts src/services/catalog/test/catalog-management.service.test.ts src/services/catalog/test/catalog-category.service.test.ts",
    "test:hardening": "node --require ./scripts/lib/register-typescript.cjs --test src/lib/test/production-hardening.test.ts scripts/tests/test-production-config.test.cjs && node --test scripts/tests/test-production-test-target.cjs && node --test scripts/tests/test-deploy-package.cjs",
    "test:auth": "node --require ./scripts/lib/register-typescript.cjs --test src/services/auth/test/auth.test.ts src/services/auth/test/team-management.service.test.ts src/repositories/auth/test/team-management.repository.test.ts scripts/tests/test-team-roles-ui.test.cjs scripts/tests/test-auth-forms.test.cjs",
    "test:print-request": "node --require ./scripts/lib/register-typescript.cjs --test src/lib/test/print-request.test.ts src/domain/print-requests/test/file-retention.test.ts scripts/tests/test-file-retention-ui.test.cjs scripts/tests/test-stl-analysis.test.cjs scripts/tests/test-stl-preview.test.cjs scripts/tests/test-print-quote-ui.test.cjs",
    "production:agent": "node scripts/workers/production-agent.cjs",
    "files:expire-requests": "node scripts/workers/expire-print-requests.cjs",
    "files:process": "node scripts/workers/private-files.cjs",
    "test:production-domain": "node --require ./scripts/lib/register-typescript.cjs --test src/domain/production/test/*.test.ts src/services/production/test/*.test.ts && node --test scripts/tests/test-production-actions-ui.test.cjs",
    "files:cleanup": "node scripts/workers/private-files-cleanup.cjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.0",
    "bootstrap": "5.3.8",
    "gsap": "3.15.0",
    "lucide-react": "1.59.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "postprocessing": "6.36.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.160.0",
    "autoprefixer": "10.5.6",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postprocessing": "$postprocessing",
    "postcss": "$postcss",
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
