# Install on Ubuntu host; replace staging.example.invalid and configure TLS with your certificate manager.
limit_req_zone $binary_remote_addr zone=minhlab_sensitive:10m rate=10r/m;
server {
    listen 443 ssl;
    server_name staging.example.invalid;
    ssl_certificate /etc/letsencrypt/live/staging.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.example.invalid/privkey.pem;
    client_max_body_size 6m;
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
    # Configure an IP allowlist or access gateway for staging here.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location = /api/print-files {
        limit_req zone=minhlab_sensitive burst=5 nodelay;
        client_max_body_size 50m;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location ~ ^/api/(auth/|orders$|payments/declare$) {
        limit_req zone=minhlab_sensitive burst=5 nodelay;
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
