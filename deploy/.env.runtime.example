# Configure directly on the host, file mode 600. DB URL and storage roots come from Compose.
MINHLAB_REQUIRE_EMAIL_VERIFICATION=true
MINHLAB_ADMIN_EMAIL=
MINHLAB_ADMIN_PASSWORD=
MINHLAB_ADMIN_NAME=Quản trị viên MinhLab
RESEND_API_KEY=
EMAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Liên kết Telegram ID tại website: Tài khoản & phân quyền.
MINHLAB_MANUAL_VIETQR_ENABLED=false
MINHLAB_VIETQR_BANK_BIN=
MINHLAB_VIETQR_BANK_NAME=
MINHLAB_VIETQR_ACCOUNT_NUMBER=
MINHLAB_VIETQR_ACCOUNT_NAME=
# Enable only after scanner, volume, backups and retention staging checks pass.
MINHLAB_PRIVATE_FILES_ENABLED=false
MINHLAB_PRIVATE_UPLOAD_MAX_BYTES=52428800
MINHLAB_PRIVATE_UPLOAD_QUOTA_BYTES=209715200
MINHLAB_PRIVATE_FILES_RETENTION_DAYS=7
MINHLAB_PRIVATE_UPLOAD_FORMATS=STL
MINHLAB_PRODUCTION_WORKER_ENABLED=false
MINHLAB_PRODUCTION_AGENT_ENABLED=false
MINHLAB_PRODUCTION_AGENT_METADATA_AUTHORIZED=false
