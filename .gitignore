# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
/.next/
/.next-dev/
/out/

# Local PostgreSQL development data
.local/

# Production build artifacts
/build
/dist

# Environment variables
.env*
!.env.example

# System & Editor files
.DS_Store
*.pem
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Python cache (build scripts)
__pycache__/
*.py[cod]
*$py.class

# Vercel
.vercel

# Generated outputs from optional model-authoring scripts
/minhlab-lab-v1.glb
/minhlab-mascot-v1.glb
/minhlab-lab-preview.png
/minhlab-mascot-detail.png
/model-info.json
/validation-report.json
/result.json
