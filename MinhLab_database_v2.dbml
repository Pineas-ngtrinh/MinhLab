Project MinhLab {
  database_type: 'PostgreSQL'
  Note: '''
    MinhLab — 3D printing storefront + made-to-order print service.
    Redesigned from scratch (v2) around three polymorphic tables that replace many
    narrow per-entity tables from v1: `attachments` (any file linked to any record),
    `stock_movements` (any inventory change, product or material), and
    `status_history` (any status transition, order/shipment/print-request/quote).
    This keeps the schema small while staying easy to extend — adding a new kind of
    attachment, stock event, or status-tracked entity never requires a new table.

    Core invariants (apply everywhere, not just where noted):
    - No hard deletes on transactional data — use status/deleted_at.
    - Uploaded files are immutable; "replacing" a file means uploading a new
      `file_assets` row and pointing a new `attachments` row at it.
    - order_items, orders (shipping snapshot), customer_approvals, and APPROVED
      print_specifications/ACCEPTED quotes are point-in-time snapshots — never
      updated in place; changes create new rows/revisions.
    - Sensitive actions (payment verification, file rejection, spec approval, quote
      revision, stock adjustment, compliance decision) are logged in `audit_logs`.
  '''
}

// =====================================================================
// 1. IDENTITY & ACCESS
// =====================================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null]
  email_normalized varchar(255) [not null, unique, note: 'lowercase+trim(email), computed by app, never user-editable']
  phone varchar(20) [unique]
  password_hash varchar(255) [not null]
  full_name varchar(120) [not null]
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING, ACTIVE, LOCKED, DISABLED']
  email_verified_at timestamptz
  phone_verified_at timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(50) [not null, unique, note: 'CUSTOMER, STAFF, FILE_REVIEWER, PRINT_OPERATOR, ADMIN']
  name varchar(100) [not null]
  description varchar(255)
  is_active boolean [not null, default: true]
}

Table user_roles {
  user_id uuid [not null]
  role_id uuid [not null]
  assigned_by uuid
  assigned_at timestamptz [not null, default: `now()`]

  indexes { (user_id, role_id) [pk] }
}

Table addresses {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  label varchar(50)
  recipient_name varchar(120) [not null]
  recipient_phone varchar(20) [not null]
  address_line varchar(255) [not null]
  ward_name varchar(120)
  district_name varchar(120)
  province_name varchar(120) [not null]
  postal_code varchar(20)
  country_code char(2) [not null, default: 'VN']
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, is_default) [name: 'idx_addresses_user_default']
  }
}

Table auth_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  refresh_token_hash varchar(255) [not null, unique]
  ip_address varchar(64)
  user_agent varchar(255)
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table account_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  purpose varchar(30) [not null, note: 'EMAIL_VERIFICATION, PASSWORD_RESET']
  token_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

// =====================================================================
// 2. FILES — one storage table + one polymorphic linking table
// =====================================================================

Table file_assets {
  id uuid [pk, default: `gen_random_uuid()`]
  uploaded_by uuid
  storage_provider varchar(30) [not null, note: 'CLOUDINARY, CLOUDFLARE_R2, LOCAL_DEV']
  bucket_name varchar(120)
  object_key varchar(500) [not null]
  secure_url text [not null]
  original_filename varchar(255) [not null]
  file_extension varchar(20) [not null]
  mime_type varchar(120) [not null]
  byte_size bigint [not null]
  sha256 char(64) [not null]
  access_level varchar(20) [not null, default: 'PRIVATE', note: 'PUBLIC, PRIVATE, INTERNAL']
  upload_status varchar(20) [not null, default: 'PENDING', note: 'PENDING, AVAILABLE, QUARANTINED, FAILED, DELETED']
  malware_scan_status varchar(20) [not null, default: 'PENDING', note: 'PENDING, CLEAN, INFECTED, FAILED']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (storage_provider, object_key) [unique, name: 'uq_file_assets_object_key']
    sha256 [name: 'idx_file_assets_sha256']
  }
}

Table attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  file_asset_id uuid [not null]
  entity_type varchar(40) [not null, note: '''
    PRODUCT, PRODUCT_VARIANT, PRINT_REQUEST_ITEM, PAYMENT, QUALITY_INSPECTION,
    PRODUCTION_ATTEMPT — extend this list freely; no schema change needed for a new kind
  ''']
  entity_id uuid [not null]
  purpose varchar(40) [note: '''
    Meaning depends on entity_type. Common values:
    PRODUCT → GALLERY_IMAGE
    PRODUCT_VARIANT → PRODUCTION_MODEL, SLICER_PROJECT, ASSEMBLY_GUIDE
    PRINT_REQUEST_ITEM → ORIGINAL_UPLOAD, CUSTOMER_REUPLOAD
    PAYMENT → PAYMENT_PROOF
    QUALITY_INSPECTION → QC_EVIDENCE
  ''']
  is_primary boolean [not null, default: false, note: 'e.g. primary product image']
  is_current boolean [not null, default: true, note: 'e.g. latest file for a print_request_item — older ones flip to false']
  sort_order int [not null, default: 0]
  uploaded_by uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, sort_order) [name: 'idx_attachments_entity']
  }

  Note: '''
    Replaces v1's product_images, product_variant_files, print_request_files,
    payment_proofs, and quality_inspection_files. No FK on (entity_type, entity_id) —
    polymorphic association, enforced at the application layer.
    Partial-uniqueness rules enforced by the app, not the DB:
    - at most one is_primary=true per (entity_type='PRODUCT', entity_id)
    - at most one is_current=true per (entity_type='PRINT_REQUEST_ITEM', entity_id)
  '''
}

// =====================================================================
// 3. CATALOG & INVENTORY
// =====================================================================

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  parent_id uuid
  name varchar(120) [not null]
  slug varchar(140) [not null, unique]
  description text
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
}

Table materials {
  id uuid [pk, default: `gen_random_uuid()`]
  material_code varchar(50) [not null, unique]
  technology varchar(10) [not null, note: 'FDM or SLA']
  material_type varchar(30) [not null, note: 'PLA, PETG, ABS, TPU, RESIN, ...']
  manufacturer varchar(120)
  product_name varchar(160)
  color_name varchar(60) [not null]
  color_hex char(7)
  inventory_unit varchar(10) [not null, note: 'GRAM (filament spools) or ML (resin, priced/tracked by weight per 1000g in practice — see stock_movements.unit)']
  unit_cost numeric(12,4) [not null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE, INACTIVE, DISCONTINUED']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (technology, material_type, status) [name: 'idx_materials_technology_type']
  }
}

Table products {
  id uuid [pk, default: `gen_random_uuid()`]
  category_id uuid [not null]
  created_by uuid

  product_code varchar(50) [not null, unique]
  model_code varchar(80) [unique, note: '''
    Code of the ORIGINAL device/model this product fits or replaces (not MinhLab's own
    code). Only used for FUNCTIONAL_REPLACEMENT items, e.g. a replacement part for a
    toy model "WHITE-B-DAMAN". Null for original designs.
  ''']
  name varchar(200) [not null]
  slug varchar(220) [not null, unique]
  short_description varchar(300)
  description text
  compatibility_note text [note: 'Required when model_code is set — must state this is an unofficial/compatible part, not the licensed original']

  product_source_type varchar(30) [not null, note: 'ORIGINAL, LICENSED, PUBLIC_DOMAIN, FUNCTIONAL_REPLACEMENT']
  production_mode varchar(20) [not null, note: 'IN_STOCK or MADE_TO_ORDER']
  publication_status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT, PUBLISHED, HIDDEN, ARCHIVED']

  compliance_status varchar(20) [not null, default: 'PENDING', note: 'PENDING, APPROVED, REJECTED, NEEDS_REVIEW']
  compliance_reviewed_by uuid
  compliance_reviewed_at timestamptz
  compliance_evidence_file_id uuid
  compliance_reference_url text
  compliance_notes text

  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (category_id, publication_status) [name: 'idx_products_category_publication']
    compliance_status [name: 'idx_products_compliance_status']
  }

  Note: '''
    Publish only when compliance_status = APPROVED. Compliance is tracked as the
    latest decision only (no separate history table — see status_history if a full
    audit trail of compliance decisions is ever needed instead of just audit_logs).
    Gallery images live in `attachments` (entity_type='PRODUCT').
  '''
}

Table product_variants {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  default_material_id uuid

  sku varchar(60) [not null, unique]
  variant_name varchar(160) [not null]
  color_name varchar(60)
  length_mm numeric(10,2) [note: '>= 0']
  width_mm numeric(10,2) [note: '>= 0']
  height_mm numeric(10,2) [note: '>= 0']
  weight_grams numeric(10,2) [note: '>= 0']
  sale_price numeric(12,2) [not null, note: '>= 0']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE, INACTIVE, OUT_OF_STOCK']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Production files (STL/slicer project/assembly guide) live in `attachments` (entity_type=\'PRODUCT_VARIANT\').'
}

Table stock_movements {
  id uuid [pk, default: `gen_random_uuid()`]
  stock_type varchar(20) [not null, note: 'PRODUCT_VARIANT or MATERIAL']
  item_id uuid [not null, note: 'FK to product_variants.id or materials.id depending on stock_type — polymorphic, no DB-level FK']
  movement_type varchar(30) [not null, note: '''
    Product: PRODUCTION_IN, SALE_OUT, RETURN_IN, DAMAGE_OUT
    Material: PURCHASE_IN, PRINT_USAGE_OUT, WASTE_OUT
    Either: ADJUSTMENT_IN, ADJUSTMENT_OUT
  ''']
  quantity_change numeric(12,3) [not null, note: 'positive = in, negative = out']
  unit varchar(10) [note: 'snapshot of the unit at the time (PIECE / GRAM / ML) for historical accuracy']
  reference_type varchar(30) [note: 'ORDER_ITEM, PRODUCTION_ATTEMPT, PURCHASE, ADJUSTMENT']
  reference_id uuid
  unit_cost_snapshot numeric(12,4) [note: 'used for PURCHASE_IN valuation']
  performed_by uuid
  reason text [note: 'required for ADJUSTMENT_*']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (stock_type, item_id, created_at) [name: 'idx_stock_movements_item']
  }

  Note: '''
    Replaces v1's inventory_movements + material_inventory_movements. Append-only.
    Current stock on hand = SUM(quantity_change) for that (stock_type, item_id); the
    app must never let this go negative.
  '''
}

// =====================================================================
// 4. CUSTOM PRINT REQUEST → INSPECTION → SPEC → QUOTE → APPROVAL
// =====================================================================

Table print_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  request_number varchar(40) [not null, unique]
  customer_id uuid [not null]
  status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT, SUBMITTED, UNDER_REVIEW, NEEDS_REUPLOAD, QUOTED, APPROVED, ORDERED, REJECTED, CANCELLED']
  customer_note text
  rights_declaration_accepted boolean [not null, default: false, note: 'customer confirms they have the right to have this file printed']
  rights_declared_at timestamptz
  submitted_at timestamptz
  closed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table print_request_items {
  id uuid [pk, default: `gen_random_uuid()`]
  print_request_id uuid [not null]
  item_number int [not null]
  item_name varchar(160) [not null]
  requested_quantity int [not null, default: 1, note: '> 0']
  customer_note text
  status varchar(20) [not null, default: 'PENDING_FILE', note: 'PENDING_FILE, UNDER_REVIEW, NEEDS_REUPLOAD, PRINTABLE, REJECTED, SPECIFIED']

  indexes {
    (print_request_id, item_number) [unique, name: 'uq_print_request_items_number']
  }

  Note: 'Uploaded files live in `attachments` (entity_type=\'PRINT_REQUEST_ITEM\').'
}

Table file_inspections {
  id uuid [pk, default: `gen_random_uuid()`]
  print_request_item_id uuid [not null]
  attachment_id uuid [not null, note: 'the specific uploaded file (attachments row) that was inspected']
  inspected_by uuid [not null]
  status varchar(30) [not null, note: 'PRINTABLE, NEEDS_CUSTOMER_REUPLOAD, REJECTED']
  detected_length_mm numeric(10,2)
  detected_width_mm numeric(10,2)
  detected_height_mm numeric(10,2)
  issue_summary text [note: 'shown to customer']
  internal_note text [note: 'staff-only']
  inspected_at timestamptz [not null, default: `now()`]

  Note: 'Records the outcome of checking printability only — MinhLab does not edit the customer\'s geometry.'
}

Table print_specifications {
  id uuid [pk, default: `gen_random_uuid()`]
  print_request_item_id uuid [not null]
  attachment_id uuid [not null, note: 'the approved-for-production file']
  material_id uuid [not null]
  created_by uuid [not null]
  revision_number int [not null, default: 1]

  source_file_sha256 char(64) [not null, note: 'snapshot copied from the linked file_assets.sha256 at the time this spec was made']
  final_length_mm numeric(10,2) [not null, note: '> 0']
  final_width_mm numeric(10,2) [not null, note: '> 0']
  final_height_mm numeric(10,2) [not null, note: '> 0']
  scale_percent numeric(6,2) [not null, default: 100, note: '> 0']
  quantity int [not null, note: '> 0']
  color_name_snapshot varchar(60)
  layer_height_mm numeric(6,3)
  infill_percent numeric(5,2) [note: '0–100']
  support_required boolean [not null, default: false]
  surface_quality_note text
  strength_note text
  tolerance_note text
  status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT, SENT_FOR_APPROVAL, APPROVED, SUPERSEDED']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (print_request_item_id, revision_number) [unique, name: 'uq_print_specifications_revision']
  }

  Note: 'Once status = APPROVED the row is immutable; a change creates a new revision and flips the old row to SUPERSEDED.'
}

Table quotes {
  id uuid [pk, default: `gen_random_uuid()`]
  quote_number varchar(40) [not null, unique]
  print_request_id uuid [not null]
  created_by uuid [not null]
  revision_number int [not null, default: 1]
  status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED, SUPERSEDED']
  currency char(3) [not null, default: 'VND']
  subtotal numeric(14,2) [not null]
  discount_amount numeric(14,2) [not null, default: 0]
  shipping_estimate numeric(14,2) [not null, default: 0]
  tax_amount numeric(14,2) [not null, default: 0]
  grand_total numeric(14,2) [not null]
  required_deposit_amount numeric(14,2) [not null, default: 0]
  valid_until timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (print_request_id, revision_number) [unique, name: 'uq_quotes_revision']
  }
}

Table quote_items {
  id uuid [pk, default: `gen_random_uuid()`]
  quote_id uuid [not null]
  print_specification_id uuid [note: 'set when line_type = PRINT_ITEM']
  line_number int [not null]
  line_type varchar(20) [not null, note: 'PRINT_ITEM, MATERIAL, MACHINE_TIME, HANDLING, PACKAGING, SHIPPING, DISCOUNT']
  description varchar(255) [not null]
  quantity numeric(10,2) [not null]
  unit_price numeric(12,2) [not null]
  line_total numeric(14,2) [not null]

  indexes {
    (quote_id, line_number) [unique, name: 'uq_quote_items_line']
  }
}

Table customer_approvals {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [not null]
  print_request_id uuid [not null]
  quote_id uuid [not null]
  recorded_by uuid [note: 'set only when staff records an offline approval on the customer\'s behalf']

  approval_status varchar(20) [not null, note: 'APPROVED or REJECTED']
  approved_file_hashes jsonb [not null, note: 'sha256 of every file the customer approved']
  specification_snapshot jsonb [not null]
  quote_snapshot jsonb [not null]
  terms_version_code varchar(40) [not null, note: 'e.g. TOS-2026-01 — points at a terms document managed outside the DB']
  terms_content_sha256 char(64) [not null]
  rights_declaration_accepted boolean [not null]
  ip_address varchar(64)
  user_agent varchar(255)
  created_at timestamptz [not null, default: `now()`]

  Note: 'Append-only legal evidence. Replaces v1\'s separate terms_versions table by embedding the terms reference directly.'
}

// =====================================================================
// 5. COMMERCE — cart, orders, payments, shipping
// =====================================================================

Table carts {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [not null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE, CONVERTED, ABANDONED']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, status) [name: 'idx_carts_customer_status']
  }

  Note: 'At most one ACTIVE cart per customer (enforced at app layer). Ready-made products only.'
}

Table cart_items {
  id uuid [pk, default: `gen_random_uuid()`]
  cart_id uuid [not null]
  product_variant_id uuid [not null]
  quantity int [not null, note: '> 0']
  added_at timestamptz [not null, default: `now()`]
}

Table orders {
  id uuid [pk, default: `gen_random_uuid()`]
  order_number varchar(40) [not null, unique]
  customer_id uuid [note: 'nullable — guest checkout for ready products']

  customer_name_snapshot varchar(120) [not null]
  customer_email_snapshot varchar(255) [not null]
  customer_phone_snapshot varchar(20) [not null]

  shipping_recipient_name varchar(120) [not null]
  shipping_recipient_phone varchar(20) [not null]
  shipping_address_line varchar(255) [not null]
  shipping_ward_name varchar(120)
  shipping_district_name varchar(120)
  shipping_province_name varchar(120) [not null]
  shipping_postal_code varchar(20)
  shipping_country_code char(2) [not null, default: 'VN']

  order_status varchar(30) [not null, default: 'PENDING_PAYMENT', note: 'PENDING_PAYMENT, DEPOSIT_PAID, CONFIRMED, IN_PRODUCTION, READY_TO_SHIP, SHIPPED, COMPLETED, CANCELLED']
  payment_status varchar(30) [not null, default: 'UNPAID', note: 'UNPAID, PARTIALLY_PAID, PAID, PARTIALLY_REFUNDED, REFUNDED']
  payment_timing varchar(20) [not null, default: 'PREPAID', note: 'PREPAID or COD — COD only allowed when every order_item.item_type = READY_PRODUCT']

  currency char(3) [not null, default: 'VND']
  subtotal numeric(14,2) [not null]
  discount_amount numeric(14,2) [not null, default: 0]
  shipping_fee numeric(14,2) [not null, default: 0]
  tax_amount numeric(14,2) [not null, default: 0]
  grand_total numeric(14,2) [not null]
  required_deposit_amount numeric(14,2) [not null, default: 0]

  customer_note text
  internal_note text
  placed_at timestamptz [not null, default: `now()`]
  cancelled_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, created_at) [name: 'idx_orders_customer_created']
    (order_status, created_at) [name: 'idx_orders_status_created']
    payment_status [name: 'idx_orders_payment_status']
  }

  Note: '''
    Shipping address is a point-in-time snapshot embedded directly (v1 had a separate
    order_addresses table for this; folded in here since an order has exactly one
    shipping destination).

    COD flow: order_status may start at CONFIRMED (skip PENDING_PAYMENT). payment_status
    stays UNPAID through production/shipping; a `payments` row (method=CASH) is only
    created once cash is collected at delivery, then verified like any other payment.

    All order_status / shipment status transitions are logged in `status_history`.
  '''
}

Table order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  product_variant_id uuid [note: 'set when item_type = READY_PRODUCT']
  print_specification_id uuid [note: 'set when item_type = CUSTOM_PRINT — exactly one of these two must be set']
  item_type varchar(20) [not null, note: 'READY_PRODUCT or CUSTOM_PRINT']

  item_name_snapshot varchar(200) [not null]
  sku_snapshot varchar(60)
  material_snapshot varchar(80)
  color_snapshot varchar(60)
  specification_snapshot jsonb [note: 'full print_specifications snapshot when CUSTOM_PRINT']

  quantity int [not null, note: '> 0']
  unit_price numeric(12,2) [not null]
  discount_amount numeric(12,2) [not null, default: 0]
  line_total numeric(14,2) [not null]
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  payment_number varchar(40) [not null, unique]
  payment_method varchar(30) [not null, note: 'BANK_TRANSFER, VIETQR, CASH']
  payment_purpose varchar(20) [not null, note: 'DEPOSIT, BALANCE, FULL_PAYMENT']
  amount numeric(14,2) [not null, note: '> 0']
  currency char(3) [not null, default: 'VND']
  transaction_reference varchar(120) [note: 'bank transfer content / reference, used to reconcile against the order_number']
  bank_name varchar(120)
  sender_account_name varchar(160)
  transferred_at timestamptz

  verification_status varchar(20) [not null, default: 'PENDING', note: 'PENDING, VERIFIED, REJECTED, REFUNDED']
  verified_by uuid
  verified_at timestamptz
  rejection_reason text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (order_id, verification_status) [name: 'idx_payments_order_verification']
    transaction_reference [name: 'idx_payments_transaction_reference']
  }

  Note: '''
    Nothing auto-verifies a payment — staff must confirm receipt, even for VietQR.
    COD: no row exists until cash is collected at delivery (method=CASH, purpose=
    FULL_PAYMENT), then it goes through the same PENDING → VERIFIED flow.
    Proof images live in `attachments` (entity_type='PAYMENT', purpose='PAYMENT_PROOF').
  '''
}

Table refunds {
  id uuid [pk, default: `gen_random_uuid()`]
  payment_id uuid [not null]
  processed_by uuid [not null]
  refund_number varchar(40) [not null, unique]
  amount numeric(14,2) [not null, note: '> 0 and <= the verified amount remaining on the payment']
  reason text [not null]
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING, COMPLETED, FAILED']
  transaction_reference varchar(120)
  created_at timestamptz [not null, default: `now()`]
}

Table shipments {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  shipment_number varchar(40) [not null, unique]
  carrier_name varchar(120)
  service_name varchar(120)
  tracking_number varchar(120) [unique]
  shipping_fee numeric(12,2)
  status varchar(20) [not null, default: 'PREPARING', note: 'PREPARING, HANDED_TO_CARRIER, IN_TRANSIT, DELIVERED, RETURNED, CANCELLED']
  shipped_at timestamptz
  expected_delivery_at timestamptz
  delivered_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Note: 'One shipment per order (MVP — no partial-shipment table; v1 had shipment_items for that case).'
}

// =====================================================================
// 6. PRODUCTION & QUALITY CONTROL
// =====================================================================

Table printers {
  id uuid [pk, default: `gen_random_uuid()`]
  printer_code varchar(30) [not null, unique]
  name varchar(120) [not null]
  technology varchar(10) [not null, note: 'FDM or SLA']
  model varchar(120)
  hourly_cost numeric(10,2)
  status varchar(20) [not null, default: 'AVAILABLE', note: 'AVAILABLE, PRINTING, MAINTENANCE, OFFLINE, RETIRED']
  last_maintenance_at timestamptz
  next_maintenance_at timestamptz
}

Table production_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  job_number varchar(40) [not null, unique]
  order_item_id uuid [not null]
  assigned_printer_id uuid
  assigned_material_id uuid
  assigned_operator_id uuid
  status varchar(20) [not null, default: 'QUEUED', note: 'QUEUED, PREPARING, PRINTING, POST_PROCESSING, QC_PENDING, COMPLETED, FAILED, CANCELLED']
  planned_start_at timestamptz
  planned_finish_at timestamptz
  actual_start_at timestamptz
  actual_finish_at timestamptz
  internal_note text
  created_at timestamptz [not null, default: `now()`]
}

Table production_attempts {
  id uuid [pk, default: `gen_random_uuid()`]
  production_job_id uuid [not null]
  printer_id uuid [not null]
  material_id uuid [not null]
  operator_id uuid [not null]
  source_attachment_id uuid [note: 'the file actually sent to the slicer/printer']
  attempt_number int [not null, default: 1]
  source_file_sha256 char(64) [note: 'for CUSTOM_PRINT jobs, must match the approved print_specifications file hash']
  slicer_settings_snapshot jsonb
  estimated_material_quantity numeric(10,3)
  actual_material_quantity numeric(10,3)
  started_at timestamptz
  finished_at timestamptz
  result varchar(20) [not null, default: 'RUNNING', note: 'RUNNING, SUCCESS, FAILED, CANCELLED']

  failure_type varchar(80) [note: 'set when result = FAILED, e.g. "Bong tróc đế", "Kẹt nhựa"']
  responsibility_group varchar(20) [note: 'CUSTOMER_FILE, MACHINE, MATERIAL, OPERATOR, POWER, UNKNOWN — set when result = FAILED']
  wasted_material_quantity numeric(10,3)
  resolution text [note: 'e.g. reprint scheduled, cancelled, customer notified']

  operator_note text

  indexes {
    (production_job_id, attempt_number) [unique, name: 'uq_production_attempts_number']
  }

  Note: 'Replaces v1\'s print_runs + print_failures — one row per physical print attempt, failure fields filled in only when result = FAILED.'
}

Table quality_inspections {
  id uuid [pk, default: `gen_random_uuid()`]
  production_job_id uuid [not null]
  inspected_by uuid [not null]
  result varchar(20) [not null, note: 'PASS, FAIL, REWORK']
  measured_length_mm numeric(10,2)
  measured_width_mm numeric(10,2)
  measured_height_mm numeric(10,2)
  quantity_passed int [not null, default: 0, note: '>= 0']
  quantity_failed int [not null, default: 0, note: '>= 0, and quantity_passed + quantity_failed <= quantity produced']
  color_check_passed boolean
  surface_check_passed boolean
  assembly_check_passed boolean
  notes text
  inspected_at timestamptz [not null, default: `now()`]

  Note: 'Evidence photos live in `attachments` (entity_type=\'QUALITY_INSPECTION\', purpose=\'QC_EVIDENCE\').'
}

// =====================================================================
// 7. CROSS-CUTTING
// =====================================================================

Table status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  entity_type varchar(30) [not null, note: 'ORDER, SHIPMENT, PRINT_REQUEST, QUOTE, PRINT_SPECIFICATION — extend freely']
  entity_id uuid [not null]
  from_status varchar(30)
  to_status varchar(30) [not null]
  changed_by uuid [note: 'null when the system changed it automatically']
  reason text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, created_at) [name: 'idx_status_history_entity']
  }

  Note: 'Replaces v1\'s order_status_history + shipment_status_history, and can log any other entity\'s status changes without a new table. Append-only.'
}

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_user_id uuid
  action varchar(80) [not null, note: 'e.g. PAYMENT_VERIFIED, FILE_REJECTED, SPEC_APPROVED, QUOTE_REVISED, STOCK_ADJUSTED, COMPLIANCE_DECIDED']
  entity_type varchar(40) [not null]
  entity_id uuid [not null]
  old_values jsonb
  new_values jsonb
  ip_address varchar(64)
  user_agent varchar(255)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, created_at) [name: 'idx_audit_logs_entity']
  }

  Note: 'Append-only. No FK on entity_id — polymorphic, same pattern as attachments/status_history/stock_movements.'
}

// =====================================================================
// RELATIONSHIPS (only for non-polymorphic FKs — the 4 polymorphic tables
// above — attachments, stock_movements, status_history, audit_logs — are
// intentionally left without DB-level FKs on their entity_id/item_id columns)
// =====================================================================

Ref: user_roles.user_id > users.id [delete: cascade]
Ref: user_roles.role_id > roles.id [delete: cascade]
Ref: user_roles.assigned_by > users.id [delete: set null]
Ref: addresses.user_id > users.id [delete: cascade]
Ref: auth_sessions.user_id > users.id [delete: cascade]
Ref: account_tokens.user_id > users.id [delete: cascade]

Ref: file_assets.uploaded_by > users.id [delete: set null]
Ref: attachments.file_asset_id > file_assets.id [delete: restrict]
Ref: attachments.uploaded_by > users.id [delete: set null]

Ref: categories.parent_id > categories.id [delete: restrict]
Ref: products.category_id > categories.id [delete: restrict]
Ref: products.created_by > users.id [delete: restrict]
Ref: products.compliance_reviewed_by > users.id [delete: set null]
Ref: products.compliance_evidence_file_id > file_assets.id [delete: set null]
Ref: product_variants.product_id > products.id [delete: restrict]
Ref: product_variants.default_material_id > materials.id [delete: restrict]
Ref: stock_movements.performed_by > users.id [delete: set null]

Ref: print_requests.customer_id > users.id [delete: restrict]
Ref: print_request_items.print_request_id > print_requests.id [delete: cascade]
Ref: file_inspections.print_request_item_id > print_request_items.id [delete: cascade]
Ref: file_inspections.attachment_id > attachments.id [delete: restrict]
Ref: file_inspections.inspected_by > users.id [delete: restrict]
Ref: print_specifications.print_request_item_id > print_request_items.id [delete: restrict]
Ref: print_specifications.attachment_id > attachments.id [delete: restrict]
Ref: print_specifications.material_id > materials.id [delete: restrict]
Ref: print_specifications.created_by > users.id [delete: restrict]
Ref: quotes.print_request_id > print_requests.id [delete: restrict]
Ref: quotes.created_by > users.id [delete: restrict]
Ref: quote_items.quote_id > quotes.id [delete: cascade]
Ref: quote_items.print_specification_id > print_specifications.id [delete: restrict]
Ref: customer_approvals.customer_id > users.id [delete: restrict]
Ref: customer_approvals.print_request_id > print_requests.id [delete: restrict]
Ref: customer_approvals.quote_id > quotes.id [delete: restrict]
Ref: customer_approvals.recorded_by > users.id [delete: set null]

Ref: carts.customer_id > users.id [delete: cascade]
Ref: cart_items.cart_id > carts.id [delete: cascade]
Ref: cart_items.product_variant_id > product_variants.id [delete: restrict]

Ref: orders.customer_id > users.id [delete: set null]
Ref: order_items.order_id > orders.id [delete: cascade]
Ref: order_items.product_variant_id > product_variants.id [delete: restrict]
Ref: order_items.print_specification_id > print_specifications.id [delete: restrict]
Ref: payments.order_id > orders.id [delete: restrict]
Ref: payments.verified_by > users.id [delete: set null]
Ref: refunds.payment_id > payments.id [delete: restrict]
Ref: refunds.processed_by > users.id [delete: restrict]
Ref: shipments.order_id > orders.id [delete: restrict]

Ref: production_jobs.order_item_id > order_items.id [delete: restrict]
Ref: production_jobs.assigned_printer_id > printers.id [delete: set null]
Ref: production_jobs.assigned_material_id > materials.id [delete: set null]
Ref: production_jobs.assigned_operator_id > users.id [delete: set null]
Ref: production_attempts.production_job_id > production_jobs.id [delete: cascade]
Ref: production_attempts.printer_id > printers.id [delete: restrict]
Ref: production_attempts.material_id > materials.id [delete: restrict]
Ref: production_attempts.operator_id > users.id [delete: restrict]
Ref: production_attempts.source_attachment_id > attachments.id [delete: set null]
Ref: quality_inspections.production_job_id > production_jobs.id [delete: restrict]
Ref: quality_inspections.inspected_by > users.id [delete: restrict]

Ref: audit_logs.actor_user_id > users.id [delete: set null]
