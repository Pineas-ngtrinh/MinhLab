# Local development only. Production must use a restricted application role,
# password authentication and verified TLS appropriate to the PostgreSQL host.
DATABASE_URL=postgresql://minhlab_dev@127.0.0.1:5433/minhlab
# Optional separate schema owner for db:migrate; leave empty for local.
MIGRATION_DATABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public catalogue image uploads. Keep all values server-side; never use NEXT_PUBLIC_ here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bootstrap a new administrator under deployment-owner control. No default login.
MINHLAB_ADMIN_EMAIL=
MINHLAB_ADMIN_PASSWORD=
MINHLAB_ADMIN_NAME=Quản trị viên MinhLab

# Production defaults to true, local defaults to false when this is empty.
# Never disable verification for a public deployment.
MINHLAB_REQUIRE_EMAIL_VERIFICATION=
RESEND_API_KEY=
EMAIL_FROM=

# Internal store and production-plan alerts. The bot must be added to the target group/channel.
# Keep both values server-side; never use NEXT_PUBLIC_ prefixes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Telegram numeric user ID=MinhLab ADMIN/STAFF user UUID; separate multiple pairs with commas.
# Liên kết Telegram ID tại website: Tài khoản & phân quyền.

# Manual VietQR: enable only after the receiving account is confirmed by the owner.
# Each new payment stores this destination; changes do not rewrite old payment instructions.
MINHLAB_MANUAL_VIETQR_ENABLED=false
MINHLAB_VIETQR_BANK_BIN=
MINHLAB_VIETQR_BANK_NAME=
MINHLAB_VIETQR_ACCOUNT_NUMBER=
MINHLAB_VIETQR_ACCOUNT_NAME=

# Optional production-agent provider: openai or groq. Keep disabled until a model/key is selected
# and the owner explicitly authorizes sanitized metadata transfer. No files, PII, prices or payment details.
# Worker cục bộ: ngưỡng đếm đơn riêng biệt; giá trị thử nghiệm có thể thay đổi.
MINHLAB_PRODUCTION_WORKER_ENABLED=false
MINHLAB_BATCH_MIN_ORDERS=3
MINHLAB_BATCH_MAX_WAIT_HOURS=24
MINHLAB_PRODUCTION_AGENT_ENABLED=false
MINHLAB_PRODUCTION_AGENT_METADATA_AUTHORIZED=false
MINHLAB_PRODUCTION_AGENT_PROVIDER=
MINHLAB_PRODUCTION_AGENT_MODEL=
MINHLAB_PRODUCTION_AGENT_API_KEY=

# Private customer file intake and payment-proof images. Set all policy fields explicitly after workshop approval.
# Root must be private, outside public/build output. Scanner is an absolute clamscan executable path.
MINHLAB_PRIVATE_FILES_ENABLED=false
MINHLAB_PRIVATE_FILES_ROOT=
MINHLAB_PRIVATE_FILES_SCANNER=
MINHLAB_PRIVATE_UPLOAD_MAX_BYTES=
MINHLAB_PRIVATE_UPLOAD_QUOTA_BYTES=
# Legacy compatibility field; model retention now follows request/order lifecycle (48h / 7d).
MINHLAB_PRIVATE_FILES_RETENTION_DAYS=7
# Separate durable journal volume, outside private root and release; required for cleanup --apply.
MINHLAB_PRIVATE_PURGE_JOURNAL_ROOT=
# Allowed 3D intake formats, explicitly chosen by the workshop; e.g. STL,OBJ,STEP.
# Payment-proof images are independently limited to JPEG/PNG/WebP, 5 MB, and use the same private root/scanner.
# OBJ/STEP require assigned reviewer inspection after malware scanning; no FDM prediction is claimed.
MINHLAB_PRIVATE_UPLOAD_FORMATS=
